# Discord bot token from https://discord.com/developers/applications
# (Bot tab -> Reset Token). Never commit your real token.
DISCORD_BOT_TOKEN=

# Shared secret clients must send as "Authorization: Bearer <value>" to /mcp.
# Required before exposing this server publicly — generate with:
#   openssl rand -hex 32
CONNECTOR_API_KEY=

# Port the HTTP server listens on (defaults to 3000).
PORT=3000

# Public HTTPS URL this server is reachable at (e.g. the Render URL). Used to
# build absolute URLs in the OAuth discovery endpoints. If unset, the server
# guesses one from request headers, which usually works but is less reliable
# behind some proxies.
PUBLIC_URL=
